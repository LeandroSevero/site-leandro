# Copie para .env.local (não versionado) para rodar localmente.
# Chaves de TESTE oficiais da Cloudflare Turnstile: sempre passam, em qualquer domínio.
# Nunca coloque as chaves reais de produção aqui nem em testes automatizados.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

