{
  "installCommand": "rm -rf node_modules && npm ci",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/:secao(sobre|skills|certificados|experiencia|sobre-o-site|contato)",
      "destination": "/"
    },
    {
      "source": "/:secao(sobre|skills|certificados|experiencia|sobre-o-site|contato)/",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "testing.leandrosevero.com.br"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/health",
      "schedule": "0 9 * * *"
    }
  ]
}
